{
  "name": "@local-packages/typescript-wallet",
  "type": "module",
  "license": "SEE LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js",
      "require": "./dist/gateway.cjs"
    },
    "./key-derivation": {
      "types": "./dist/key-derivation.d.ts",
      "import": "./dist/key-derivation.js",
      "require": "./dist/key-derivation.cjs"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "import": "./dist/transactions.js",
      "require": "./dist/transactions.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typo-check": "cspell -c ../../cspell.json . --quiet",
    "examples:generate-mnemonic": "bun ./examples/scripts/generate-mnemonic.ts",
    "examples:faucet": "bun ./examples/scripts/faucet.ts",
    "examples:account-address": "bun ./examples/scripts/account-address.ts",
    "examples:deploy-package": "bun ./examples/deploy-package.ts",
    "examples:gw:well-known": "bun ./examples/scripts/gw/well-known.ts",
    "examples:gw:tx:lookup": "bun ./examples/scripts/gw/lookup-tx.ts",
    "examples:gw:status": "bun ./examples/scripts/gw/status.ts",
    "examples:gw:state:details": "bun ./examples/scripts/gw/state-details.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@radixdlt/babylon-gateway-api-sdk": "^1.10.1",
    "@radixdlt/radix-engine-toolkit": "^1.0.6",
    "bip39": "^3.1.0",
    "blakejs": "^1.2.1",
    "dotenv": "^16.4.5",
    "hdkey": "^2.1.0",
    "lodash.chunk": "^4.2.0",
    "neverthrow": "^7.0.0",
    "rxjs": "^7.8.1",
    "tslog": "^4.9.3"
  }
}
